# AI Hedge Fund / swarm-trader — Environment Variables
# Copy this to .env and fill in your keys.
# .env is gitignored and will NOT be committed.

# =============================================================================
# LLM (recommended for Elestio / production)
# =============================================================================
# OpenRouter is the default cloud provider when OPENROUTER_API_KEY is set.
OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=OpenRouter
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Other LLM providers (optional — only needed if NOT using OpenRouter/Ollama)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=

# =============================================================================
# Market data
# =============================================================================
# Price order: Alpaca SIP (when keys + feed=sip) → Tiingo → yfinance
# Alpaca SIP recent data requires Algo Trader Plus subscription.
# Trading stays paper unless ALPACA_TRADING_MODE=live (data API is separate).
TIINGO_API_KEY=

# Alpaca market data (same keys as trading; data URL/feed are independent)
# ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=sip
# sip | iex | delayed_sip — default sip when unset

# SEC EDGAR requires a User-Agent header (name + email). Optional override:
# SEC_USER_AGENT=YourApp admin@example.com

# Financial data (DEPRECATED — no longer required)
# FINANCIAL_DATASETS_API_KEY=

# =============================================================================
# Alpaca trading
# WARNING: ALPACA_TRADING_MODE=live places REAL orders with REAL money.
# Default is paper. Double-check before going live.
# =============================================================================
# paper (default) | live
ALPACA_TRADING_MODE=paper
# Optional explicit override (takes precedence over ALPACA_TRADING_MODE):
# ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
# ALPACA_BASE_URL=https://api.alpaca.markets/v2

# Primary / Swing account (required for trading + preferred SIP market data)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional: account ID for logging (found in Alpaca dashboard)
# ALPACA_ACCOUNT_ID=

# Day Trading account (optional — separate account for intraday trades)
# If not set, both modes share the primary account.
# ALPACA_DAY_API_KEY=
# ALPACA_DAY_API_SECRET=
# ALPACA_DAY_ACCOUNT_ID=

# =============================================================================
# Web UI / production
# =============================================================================
# Backend CORS origins (comma-separated). Defaults include localhost Vite + prod.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Frontend build-time API URL (docker-compose.prod.yml)
# VITE_API_URL=http://localhost:8000

# =============================================================================
# A2A Peer Signal Sharing (optional — intel_exchange.py)
# =============================================================================
# SWARM_AGENT_NAME=my-agent
# PEER_A2A_URL=http://peer-host:9092/a2a/tasks/send
# PEER_A2A_TOKEN=

# =============================================================================
# Cron automation (A1/A2) — paper-only
# =============================================================================
# Required for /cron/* routes. Set in Elestio env — do NOT commit a real value.
# Header: X-Swarm-Cron-Secret: <value>
SWARM_CRON_SECRET=

# Portfolio monitor dry-run gate. Default true (safe). Hot paper sells only when
# this is "false" AND the cron body sends dry_run=false. Requires James/Reviewer ack.
SWARM_MONITOR_DRY_RUN=true

# Dual gate for cron paper execute. Default unset/false = analysis-only.
# Hot execute only when this is truthy AND recipe/body execute_trades=true.
SWARM_CRON_EXECUTE_TRADES=false

# Optional override for automation status directory (default /app/data/automation)
# SWARM_AUTOMATION_DIR=/app/data/automation

# Wave C — Auto Swarm Orchestrator. Default absent/false = cron scan-only.
# When truthy, POST /api/cron/swarm-scan may honor apply_recipe and/or launch
# (paper analysis only). Execute still requires SWARM_CRON_EXECUTE_TRADES ∧ recipe.
# Never flips SWARM_MONITOR_DRY_RUN or live trading via the scan path.
SWARM_AUTO_LAUNCH=false

# Build stamp (optional; compose/Dockerfile also accept GIT_SHA build-arg)
# GIT_SHA=
